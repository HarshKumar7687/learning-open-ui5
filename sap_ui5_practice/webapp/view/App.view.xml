<mvc:View
  controllerName="ui5.tutorial.walkthrough.controller.App"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:form="sap.ui.layout.form"
  displayBlock="true">
  
    <App class="myAppDemoWT" id="app">
      <pages>
      <Shell>
        <Page id="page1" title="{i18n>homePageTitle}" titleAlignment="Center">
          <content>
           <mvc:XMLView viewName="ui5.tutorial.walkthrough.view.HelloPanel"/>
           <mvc:XMLView viewName="ui5.tutorial.walkthrough.view.Panel"/>
            <Button text="Go to Page 2" press=".onNavigateToPage2" class="sapUiMediumMarginBegin" type="Emphasized"/>
          </content>
      </Page>
      </Shell>
        <Page id="page2" title="{i18n>homePageTitle2}" titleAlignment="Center" backgroundDesign="List" class="myPageWithBgImage">
            <content>
              <mvc:XMLView viewName="ui5.tutorial.walkthrough.view.InvoiceList"/>
              <Button text="Back" press=".onNavigateBack" class="sapUiMediumMarginBegin" type="Negative"/>
              <Button text="Go to Page 3" press=".onNavigateToPage3" class="sapUiMediumMarginBegin" type="Emphasized"/>
            </content >
      </Page>
      <Page id="page3" title="Invoice Table" titleAlignment="Center" class="myPageWithBgImage1">
        <content>
        <mvc:XMLView viewName="ui5.tutorial.walkthrough.view.InvoiceTable"/>
        <Button text="Back" press=".onNavigateBack" class="sapUiMediumMarginBegin" type="Negative"/>
        <Button text="Go to Page 4" press=".onNavigateToPage4" class="sapUiMediumMarginBegin" type="Emphasized"/>
        </content>
      </Page>
      <Page id="page4" title="Profile" titleAlignment="Center">
          <content>
              <mvc:XMLView viewName="ui5.tutorial.walkthrough.view.Profile"/>
              <Button text="Back" press=".onNavigateBack" class="sapUiMediumMarginBegin" type="Negative"/>
          </content>
      </Page>
      </pages>
    </App>

</mvc:View>