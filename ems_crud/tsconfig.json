{
    "compilerOptions": {
        "target": "es2023",
        "module": "es2022",
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "allowJs": true,
        "strict": true,
        "strictPropertyInitialization": false,
        "rootDir": "./webapp",
        "paths": {
            "ems_crud/*": [
                "./webapp/*"
            ]
        },
        "types": [
            "@openui5/types"
        ],
        "composite": true
    },
    "include": [
        "./webapp/**/*"
    ]
}