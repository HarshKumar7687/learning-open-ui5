<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout.form">

    <l:SimpleForm
        editable="true"
        layout="ResponsiveGridLayout"
        labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12">
        <core:Title text="Personal &amp; Employment Details" />

        <Label text="Profile Picture URL" />
        <Input id="photoUrlInput" value="{draft>/PhotoUrl}" placeholder="https://... (optional — initials are shown if left empty)" />

        <Label text="Name" required="true" />
        <Input id="nameInput" value="{draft>/Name}" />

        <Label text="Address" required="true" />
        <TextArea id="addressInput" value="{draft>/Address}" rows="2" width="100%" />

        <Label text="Deposit" required="true" />
        <Input id="depositInput" value="{draft>/Deposit}" type="Number" description="INR" />

        <Label text="Joining Date" required="true" />
        <DatePicker id="joiningDatePicker" value="{
            path: 'draft>/JoiningDate',
            type: 'sap.ui.model.type.Date',
            formatOptions: { source: { pattern: 'yyyy-MM-dd' }, pattern: 'yyyy-MM-dd' }
        }" />

        <Label text="Department" required="true" />
        <Select id="departmentSelect" selectedKey="{draft>/Department}" items="{/Departments}">
            <core:Item key="{}" text="{}" />
        </Select>

        <Label text="Working Location" required="true" />
        <Input id="locationInput" value="{draft>/WorkingLocation}" />

        <Label text="Owns Vehicle" />
        <CheckBox id="ownsVehicleCheckBox" selected="{draft>/OwnsVehicle}" select="onOwnsVehicleChange" />

        <Label text="Vehicle Type" />
        <Select id="vehicleTypeSelect" selectedKey="{draft>/VehicleType}" enabled="{draft>/OwnsVehicle}" items="{/VehicleTypes}">
            <core:Item key="{}" text="{}" />
        </Select>

        <Label text="Previous Organisation" />
        <Input id="prevOrgInput" value="{draft>/PreviousOrganisation}" />

        <Label text="Skills" required="true" />
        <Input id="skillsInput" value="{draft>/SkillsText}" placeholder="Comma-separated, e.g. JavaScript, OpenUI5, SQL" />
    </l:SimpleForm>

    <Toolbar>
        <Title text="Work Experience History" level="H3" />
        <ToolbarSpacer />
        <Button text="Add Row" icon="sap-icon://add" press="onAddWorkHistoryRow" />
    </Toolbar>

    <Table id="workHistoryTable" items="{draft>/WorkHistory}" noDataText="No work history added">
        <columns>
            <Column><Text text="Company" /></Column>
            <Column><Text text="Designation" /></Column>
            <Column><Text text="Duration" /></Column>
            <Column hAlign="Center"><Text text="" /></Column>
        </columns>
        <items>
            <ColumnListItem>
                <cells>
                    <Input value="{draft>Company}" />
                    <Input value="{draft>Designation}" />
                    <Input value="{draft>Duration}" placeholder="e.g. 2019-2022" />
                    <Button text="Remove" type="Negative" press="onDeleteWorkHistoryRow" tooltip="Remove row" />
                </cells>
            </ColumnListItem>
        </items>
    </Table>
</core:FragmentDefinition>
