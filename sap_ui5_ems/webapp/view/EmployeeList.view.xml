<mvc:View
    controllerName="ems.controller.EmployeeList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <Page id="listPage" title="Employees" class="sapUiResponsivePadding">
        <content>
            <Toolbar id="searchToolbar">
                <SearchField
                    id="searchField"
                    width="24rem"
                    placeholder="Search by name, department, location or previous organization"
                    liveChange="onSearch"
                    search="onSearch" />
                <ToolbarSpacer />
                <Button
                    id="addButton"
                    text="Add Employee"
                    type="Emphasized"
                    icon="sap-icon://add-employee"
                    press="onAdd" />
            </Toolbar>

            <Table
                id="employeeTable"
                items="{/Employees}"
                noDataText="No employees found"
                growing="true"
                growingThreshold="20">
                <columns>
                    <Column width="3.5rem"><Text text="" /></Column>
                    <Column>
                        <header>
                            <HBox alignItems="Center">
                                <core:Icon
                                    src="sap-icon://employee"
                                    class="sapUiTinyMarginEnd" />
                                <Text text="Name" />
                            </HBox>
                        </header>
                    </Column>
                    <Column>
                        <header>
                            <HBox alignItems="Center">
                                <core:Icon
                                    src="sap-icon://group"
                                    class="sapUiTinyMarginEnd" />
                                <Text text="Department" />
                            </HBox>
                        </header>
                    </Column>
                    <Column>
                        <header>
                            <HBox alignItems="Center">
                                <core:Icon
                                    src="sap-icon://functional-location"
                                    class="sapUiTinyMarginEnd" />
                                <Text text="Working Location" />
                            </HBox>
                        </header>
                    </Column>
                    <Column>
                        <header>
                            <HBox alignItems="Center">
                                <core:Icon
                                    src="sap-icon://appointment"
                                    class="sapUiTinyMarginEnd" />
                                <Text text="Joining Date" />
                            </HBox>
                        </header>
                    </Column>
                    <Column hAlign="Center">
                        <header>
                            <HBox alignItems="Center">
                                <core:Icon
                                    src="sap-icon://car-rental"
                                    class="sapUiTinyMarginEnd" />
                                <Text text="Owns Vehicle" />
                            </HBox>
                        </header>
                    </Column>
                    <Column hAlign="Center">
                        <header>
                            <HBox alignItems="Center">
                                <core:Icon
                                    src="sap-icon://action"
                                    class="sapUiTinyMarginEnd" />
                                <Text text="Actions" />
                            </HBox>
                        </header>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Avatar
                                src="{PhotoUrl}"
                                initials="{path:'Name', formatter:'.formatter.getInitials'}"
                                displayShape="Circle"
                                displaySize="S"
                                class="sapUiSmallMarginEnd" />
                            <Text text="{Name}" class="sapUiSmallMarginStart" />
                            <Text text="{Department}" />
                            <Text text="{WorkingLocation}" />
                            <Text text="{
                                path: 'JoiningDate',
                                type: 'sap.ui.model.type.Date',
                                formatOptions: { source: { pattern: 'yyyy-MM-dd' }, style: 'medium' }
                            }" />
                            <core:Icon
                                src="{= ${OwnsVehicle} ? 'sap-icon://accept' : 'sap-icon://decline' }"
                                color="{= ${OwnsVehicle} ? '#107e3e' : '#bb0000' }" />
                            <HBox justifyContent="Center">
                                <Button icon="sap-icon://display" type="Transparent" press="onViewProfile" tooltip="View Profile" />
                                <Button icon="sap-icon://edit" type="Transparent" press="onEditEmployee" tooltip="Edit" />
                                <Button icon="sap-icon://delete" type="Transparent" press="onDeleteEmployee" tooltip="Delete" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
